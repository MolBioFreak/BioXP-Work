{
  "schema_version": "bioxp.manual_source_pipetting.v1",
  "authoring_routes": {
    "compile": "POST /liquid/manual/compile",
    "execute": "POST /liquid/manual/execute",
    "native_submit": "POST /protocol/execute",
    "request_model": "bioxp.manual_pipetting.ManualPipettingRequest",
    "execute_model": "bioxp.api.ManualPipettingExecuteRequest"
  },
  "existing_surfaces_not_duplicated": {
    "POST /liquid/keep-tip": "PipetteKeepTipRequest -> FourPipetteTransport.KeepTip",
    "POST /liquid/aspirate-air": "PipetteAirRequest -> aspirate_air (primitive, no source LiftForAir)",
    "POST /liquid/dispense-air": "PipetteAirRequest -> dispense_air (primitive, distinct from source da)",
    "POST /liquid/mix-all": "PipetteMixAllRequest -> mix_all; unchanged collection tip-type-as-volume behavior",
    "POST /liquid/dispense-all": "PipetteDispenseAllRequest -> dispense_all",
    "POST /liquid/terminate": "PipetteTerminateRequest -> terminate; addressed device stop, not HTTP cancellation",
    "POST /liquid/heartbeat": "PipetteHeartbeatRequest -> heartbeat",
    "POST /liquid/pipette/tip-type": "PipetteTipTypeRequest -> loadTip; host metadata only"
  },
  "step_schema": {
    "$defs": {
      "SourceAir": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "enum": [
              "source_aspirate_air",
              "source_dispense_air"
            ],
            "title": "Operation",
            "type": "string"
          },
          "volume_ul": {
            "title": "Volume Ul",
            "type": "number"
          }
        },
        "required": [
          "operation",
          "volume_ul"
        ],
        "title": "SourceAir",
        "type": "object"
      },
      "SourceLoadTips": {
        "additionalProperties": false,
        "description": "newloadTips, not calibration loadTips or manual tray/well pickup.\n\nA matching tip type with force_new_tip=False returns without realignment.\nPipette is the OEM zero-based index; -1 is the fixed four-head group.",
        "properties": {
          "operation": {
            "const": "source_load_tips",
            "title": "Operation",
            "type": "string"
          },
          "tip_type": {
            "enum": [
              50,
              200
            ],
            "title": "Tip Type",
            "type": "integer"
          },
          "pipette": {
            "maximum": 3,
            "minimum": -1,
            "title": "Pipette",
            "type": "integer"
          },
          "force_new_tip": {
            "title": "Force New Tip",
            "type": "boolean"
          }
        },
        "required": [
          "operation",
          "tip_type",
          "pipette",
          "force_new_tip"
        ],
        "title": "SourceLoadTips",
        "type": "object"
      },
      "SourceMix": {
        "additionalProperties": false,
        "description": "ControlLib.mmix scientific procedure, not repeated manual strokes.",
        "properties": {
          "operation": {
            "const": "source_mix",
            "title": "Operation",
            "type": "string"
          },
          "volume_ul": {
            "title": "Volume Ul",
            "type": "number"
          },
          "air_ul": {
            "default": 15.0,
            "title": "Air Ul",
            "type": "number"
          },
          "aspirate_speed": {
            "default": 100.0,
            "title": "Aspirate Speed",
            "type": "number"
          },
          "dispense_speed": {
            "default": 20.0,
            "title": "Dispense Speed",
            "type": "number"
          },
          "aspirate_delay_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Aspirate Delay Ms"
          },
          "dispense_delay_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dispense Delay Ms"
          },
          "cycles": {
            "default": 2,
            "minimum": 0,
            "title": "Cycles",
            "type": "integer"
          },
          "mix_type": {
            "default": "N",
            "enum": [
              "N",
              "H",
              "C"
            ],
            "title": "Mix Type",
            "type": "string"
          },
          "tip_dip": {
            "default": true,
            "title": "Tip Dip",
            "type": "boolean"
          }
        },
        "required": [
          "operation",
          "volume_ul"
        ],
        "title": "SourceMix",
        "type": "object"
      },
      "SourcePurge": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "source_purge",
            "title": "Operation",
            "type": "string"
          },
          "speed": {
            "default": 30.0,
            "title": "Speed",
            "type": "number"
          },
          "amp": {
            "default": false,
            "title": "Amp",
            "type": "boolean"
          },
          "ntd": {
            "default": false,
            "title": "Ntd",
            "type": "boolean"
          }
        },
        "required": [
          "operation"
        ],
        "title": "SourcePurge",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "source_aspirate_air": "#/$defs/SourceAir",
        "source_dispense_air": "#/$defs/SourceAir",
        "source_load_tips": "#/$defs/SourceLoadTips",
        "source_mix": "#/$defs/SourceMix",
        "source_purge": "#/$defs/SourcePurge"
      },
      "propertyName": "operation"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/SourceLoadTips"
      },
      {
        "$ref": "#/$defs/SourceMix"
      },
      {
        "$ref": "#/$defs/SourceAir"
      },
      {
        "$ref": "#/$defs/SourcePurge"
      }
    ]
  },

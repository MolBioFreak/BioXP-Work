# Exclude raw SSD dumps and massive binaries
BioXP_SSD_Backup/
dlls/
*.dll
*.dll.deploy
*.exe
*.sys
*.mdf
*.ldf

# Exclude IDE/OS temp files
.idea/
.vscode/
__pycache__/
*.pyc
.DS_Store
.venv/
.pytest_cache/

# Exclude large snapshot images from vision system
scripts/snapshots/
scripts/Local Served Jobs/
output/

# Local agent/planning scratch files
.hermes/
# Local raw OEM AppData extracts may contain instrument/server fields; commit redacted manifests only.
config/oem/original_ssd_appdata_*/
# Historical implementation backups must not live beside active runtime source.
backup-bin/
*.bak-*
*.py.bak-*

  "routes": [
    {
      "equivalence": "not-equivalent-to-manual-home",
      "maps_to": "stepwise initializeMotors subset",
      "method": "POST",
      "notes": [
        "Raw FastAPI lives inside robot/container network in this setup.",
        "Use this for supervised OEM startup steps, not as a generic Home button."
      ],
      "route": "/motion/oem/startup_step",
      "surface": "raw-fastapi"
    },
    {
      "equivalence": "not-equivalent-to-single-axis-home-or-zero",
      "maps_to": "direct HomeXY mode surface",
      "method": "POST",
      "notes": [
        "Preserves HomeXY source-mode label and launches X/Y goHome concurrently like OEM Task.Run/WaitAll.",
        "This is not manual single-axis Home and not controller Zero."
      ],
      "route": "/motion/oem/home_xy",
      "surface": "raw-fastapi"
    },
    {
      "equivalence": "intentionally-blocked-no-monolithic-live-homing",
      "maps_to": "ControlLib.rehome source-mode surface",
      "method": "POST",
      "notes": [
        "Direct monolithic rehome is intentionally blocked; run_homing=true does not enable physical homing.",
        "Door save/restore gap remains explicit."
      ],
      "route": "/motion/oem/rehome",
      "surface": "raw-fastapi"
    },
    {
      "equivalence": "intentionally-blocked-no-monolithic-live-homing",
      "maps_to": "ControlLib.initializeMotion source-mode surface",
      "method": "POST",
      "notes": [
        "No-homing diagnostic by default; run_homing=true reaches intentionally blocked rehome and does not enable physical homing.",
        "Tip/pipette cleanup is labeled not ported."
      ],
      "route": "/motion/oem/initialize_motion",
      "surface": "raw-fastapi"
    },
    {
      "equivalence": "intentionally-blocked-no-monolithic-live-homing",
      "maps_to": "OEM initialization controller",
      "method": "POST",
      "notes": [
        "No-homing controller pass is available; run_homing=true returns fail-closed before controller or tester access.",
        "This is not a physical initializeMotors/rehome monolith."
      ],
      "route": "/motion/oem/initialization/run",
      "surface": "raw-fastapi"
    },
    {
      "equivalence": "not-equivalent-to-startup-axisSearchHome",
      "maps_to": "manual button goHome-style route",
      "method": "POST",
      "notes": [
        "Historically routed through _execute_home_axis(... startup=False).",
        "Unsafe until per-axis predicates/transitions are repaired and proven."
      ],
      "route": "/motion/axis/home",
      "surface": "raw-fastapi"
    },
    {
      "equivalence": "linux-only-not-oem-home",
      "maps_to": "Linux absolute controller-zero route",
      "method": "POST",
      "notes": [
        "Return-to-controller-zero is not switch/reference homing."
      ],
      "route": "/motion/axis/zero",
      "surface": "raw-fastapi"
    },
    {
      "equivalence": "proxy-not-authority",
      "maps_to": "proxy/linkage to raw startup_step when exposed",
      "method": "POST",
      "notes": [
        "BMS may expose/proxy a subset and status shape can differ from raw robot API."
      ],
      "route": "/api/bioxp/motion/oem/startup_step",
      "surface": "bms-proxy"
    },
    {
      "equivalence": "proxy-not-authority",
      "maps_to": "proxy/linkage to raw manual home when exposed",
      "method": "POST",
      "notes": [
        "Do not assume this is present or a full mirror; probe route existence separately."
      ],
      "route": "/api/bioxp/motion/axis/home",
      "surface": "bms-proxy"
    }
